#!/bin/bash

# omarchy:summary=Set the current background image
# omarchy:args=[--monitor <output>|--all] <path-to-image>
# omarchy:examples=omarchy theme bg set ~/Pictures/background.png|omarchy theme bg set --monitor DP-4 ~/Pictures/portrait.png

CURRENT_BACKGROUND_LINK="$HOME/.local/state/omarchy/current/background"
PER_MONITOR_MAP="$HOME/.local/state/omarchy/current/backgrounds.json"

monitor=""
clear_overrides=false

while [[ $1 == --* ]]; do
  case "$1" in
    --monitor)
      shift
      monitor="$1"
      ;;
    --all)
      clear_overrides=true
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
  shift
done

if [[ -z $1 ]]; then
  echo "Usage: omarchy-theme-bg-set [--monitor <output>|--all] <path-to-image>" >&2
  exit 1
fi

BACKGROUND="$(realpath "$1")"

if [[ ! -f $BACKGROUND ]]; then
  echo "File does not exist: $BACKGROUND" >&2
  exit 1
fi

if [[ -n $monitor ]]; then
  # Per-monitor override: upsert <output> -> path into the JSON map that the
  # background plugin reads. The shared background stays untouched.
  mkdir -p "$(dirname "$PER_MONITOR_MAP")"
  tmp="$(mktemp)"
  if [[ -f $PER_MONITOR_MAP ]]; then
    jq --arg m "$monitor" --arg p "$BACKGROUND" '. + {($m): $p}' "$PER_MONITOR_MAP" >"$tmp"
  else
    jq -n --arg m "$monitor" --arg p "$BACKGROUND" '{($m): $p}' >"$tmp"
  fi
  mv "$tmp" "$PER_MONITOR_MAP"

  # Re-read the map in the live shell. The plugin also polls it, but the
  # explicit refresh avoids the visible delay.
  omarchy-shell -q background refresh
else
  # Shared background for every monitor. --all also drops per-monitor overrides
  # so the chosen image really shows everywhere; a plain set leaves overrides in
  # place (theme switches reuse it and must not discard a user's per-monitor
  # choices).
  if [[ $clear_overrides == true && -f $PER_MONITOR_MAP ]]; then
    rm -f "$PER_MONITOR_MAP"
  fi

  # Create symlink to the new background
  ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"

  # Update the live shell background immediately when it is running. The
  # background plugin also polls this symlink, but IPC avoids the visible delay.
  omarchy-shell -q background set "$BACKGROUND"

  if [[ $clear_overrides == true ]]; then
    omarchy-shell -q background refresh
  fi
fi
